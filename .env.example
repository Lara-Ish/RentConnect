# RentConnect Environment Configuration
# Copy this file to .env and configure your Gmail SMTP credentials

# Gmail SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_AUTH=true

# Replace with your Gmail address and 16-character App Password (not your normal Gmail password)
# To generate a Gmail App Password: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password

# From Address Settings
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Apartment Management System

# Base Application URL (used for password reset links and notification action buttons)
APP_URL=http://localhost/RentConnect
